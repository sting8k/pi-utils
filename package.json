{
	"name": "@sting8k/pi-utils",
	"version": "0.10.0",
	"description": "Utility extensions for the Pi coding agent: background shell (shell-bg) with bash search routing, script-mode edit, and the skills write layer (skill_write)",
	"type": "module",
	"license": "MIT",
	"files": [
		"extensions/",
		"src/",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-coding-agent"
	],
	"scripts": {
		"check": "biome check --error-on-warnings . && tsc --noEmit",
		"test": "bun test"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.80.0 <2.0.0",
		"@sting8k/pi-droid-styling": ">=2.13.0",
		"typebox": ">=1.1.24 <2.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@earendil-works/pi-coding-agent": "^1.0.0",
		"@earendil-works/pi-tui": "1.0.0",
		"@sting8k/pi-droid-styling": "file:../pi-droid-styling",
		"@types/bun": "^1.4.2",
		"@types/node": "^20.0.0",
		"typebox": "^1.3.30",
		"typescript": "^5.5.0"
	},
	"pi": {
		"extensions": [
			"./extensions/shell-bg.ts",
			"./extensions/edit.ts",
			"./extensions/read.ts",
			"./extensions/skill-write.ts"
		]
	},
	"peerDependenciesMeta": {
		"@sting8k/pi-droid-styling": {
			"optional": true
		}
	},
	"dependencies": {
		"@jsquash/jpeg": "^1.6.0",
		"@jsquash/png": "^3.1.1",
		"yaml": "^2.9.0"
	}
}
