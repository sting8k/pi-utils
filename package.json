{
	"name": "@sting8k/pi-utils",
	"version": "0.1.0",
	"description": "Utility extensions for the Pi coding agent: deep fs-search (grep/glob) and background shell (shell-bg)",
	"type": "module",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi-extension",
		"pi-coding-agent"
	],
	"scripts": {
		"check": "biome check --error-on-warnings . && tsc --noEmit",
		"test": "bun test"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.80.0 <1.0.0",
		"@sting8k/pi-droid-styling": ">=2.13.0",
		"typebox": ">=1.1.24 <2.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@earendil-works/pi-coding-agent": "^0.85.1",
		"@earendil-works/pi-tui": "0.85.1",
		"@sting8k/pi-droid-styling": "file:../pi-droid-styling",
		"@types/bun": "^1.4.2",
		"@types/node": "^20.0.0",
		"typebox": "^1.3.30",
		"typescript": "^5.5.0"
	},
	"pi": {
		"extensions": [
			"./extensions/fs-search.ts",
			"./extensions/shell-bg.ts"
		]
	},
	"peerDependenciesMeta": {
		"@sting8k/pi-droid-styling": {
			"optional": true
		}
	}
